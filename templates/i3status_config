general {
    interval = 5
    colors = true
    color_good = "#8C9440"
    color_bad = "#A54242"
    color_degraded = "#DE935F"
}

order += "disk /"
order += "ethernet ens160"
order += "battery 0"
order += "load"
order += "tztime local"

ethernet eth0 {
    # if you use %speed, i3status requires root privileges
    format_up = "󰈀 %ip"
    format_down = "󰈀"
}

ethernet ens160 {
    # if you use %speed, i3status requires root privileges
    format_up = "󰈀 %ip"
    format_down = "󰈀"
}

wireless _first_ {
    format_up = " (%essid - %quality) %ip"
    format_down = ""
}

run_watch DHCP {
    pidfile = "/var/run/dhclient*.pid"
}

run_watch VPN {
    pidfile = "/var/run/vpnc/pid"
}

tztime local {
    format = " %Y-%m-%d %H:%M:%S"
}

load {
    format = " %1min"
}

disk "/" {
    format = "\ %avail"
}

battery 0 {
    format = "%status %percentage %remaining"
    status_bat = ""
    status_chr = ""
    status_full = ""
    low_threshold = 30
    threshold_type = percentage
    integer_battery_capacity = true
    color_good = "#0000FF"
}
