{
  "proxy": "",
  "show_edit_predictions": false,
  "agent_servers": {
    "claude-acp": {
      "type": "registry"
    },
    "cursor": {
      "type": "registry"
    }
  },
  "agent_buffer_font_size": 14.0,
  "agent_ui_font_size": 17.0,
  "ui_font_family": ".ZedSans",
  "terminal": {
    "font_size": 13.0
  },
  "edit_predictions": {
    "allow_data_collection": "no",
    "mode": "subtle"
  },
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "buffer_font_family": "NotoSansM Nerd Font Mono",
  "diagnostics": {
    "inline": {
      "enabled": true
    }
  },
  "prettier": {
    "allowed": true
  },
  "inlay_hints": {
    "show_value_hints": false,
    "show_parameter_hints": false,
    "enabled": false
  },
  "toolbar": {
    "code_actions": true
  },
  "relative_line_numbers": "enabled",
  "auto_signature_help": false,
  "hover_popover_enabled": false,
  "helix_mode": true,
  "agent": {
    "sidebar_side": "right",
    "dock": "right",
    "default_profile": "write",
    "default_model": {
      "provider": "ollama",
      "model": "gemma4:e4b",
      "enable_thinking": true
    },
    "favorite_models": [],
    "model_parameters": []
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "icon_theme": "Zed (Default)",
  "vim_mode": false,
  "ui_font_size": 15,
  "buffer_font_size": 14,
  "git": {
    "inline_blame": {
      "enabled": false
    }
  },
  "theme": "Catppuccin Mocha - No Italics",
  "theme_overrides": {
    "Catppuccin Mocha - No Italics": {
      "border.variant": "#585b70",
      "border.focused": "#45475a",
      "border.selected": "#45475a"
    }
  },
  "languages": {
    "Rust": {
      "formatter": "language_server",
      "format_on_save": "on"
    }
  }
}