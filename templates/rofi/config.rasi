configuration {
  modi: "run,drun,window";
  terminal: "alacritty";
  icon-theme: "Oranchelo";
  show-icons: true;
  drun-display-format: "{icon} {name}";
  window-format: "{w} {c} {t}";
  location: 0;
  disable-history: false;
  hide-scrollbar: true;
  display-drun: "  ";
  display-window: "  ";
  display-run: "  ";
  dpi: 220;
  placeholder: "Search...";
}

@theme "theme.rasi"
