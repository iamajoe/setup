[Unit]
Description=Create encrypted docker-data backup in Proton Drive
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=%h/.local/bin/syncdrive-backup-docker-data
ExecStartPost=systemctl --user start rclone-protondrive-bisync.service
StandardOutput=append:%h/.local/state/syncdrive-docker-data-backup.log
StandardError=append:%h/.local/state/syncdrive-docker-data-backup.log
